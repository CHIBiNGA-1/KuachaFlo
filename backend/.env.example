# Local stage — everything defaults to sane values with zero setup,
# except GEMINI_API_KEY and SUPABASE_URL which are required.
#
# Copy this to backend/.env if you're running WITHOUT Docker (uvicorn
# reads it directly). If you're using docker compose, put your values in
# the .env file at the PROJECT ROOT instead — see ../.env.example.

DATABASE_URL=sqlite:///./data/snapledger.db
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:3000

# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase project URL — used to verify Auth tokens via the public JWKS
# endpoint. Only the URL, never the secret/service_role key.
SUPABASE_URL=
