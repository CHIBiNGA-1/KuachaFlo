# Copy to .env and fill in. Every integration below is optional except
# DATABASE_URL — the app runs fine (with WhatsApp capture and billing
# notifications dormant) if you leave the rest blank.

# Postgres in production; sqlite is fine for local dev (the default).
DATABASE_URL=sqlite:///./data/app.db

# Supabase project (Settings → API). Used for auth-token verification
# (SUPABASE_URL alone is enough for that) — the service role key is only
# needed if you wire up Storage yourself later.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed frontend origins, or "*" for any.
ALLOWED_ORIGINS=*

# Shared secret for the /api/v1/admin/* endpoints (X-Admin-Key header).
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# Gemini powers the optional WhatsApp sales-sheet capture pipeline
# (app/classify.py, app/shop_capture.py). Get a key at aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram bot that pings you when a MoMo payment claim comes in.
# Message @BotFather to create a bot and grab the token; message your bot
# once, then hit https://api.telegram.org/bot<token>/getUpdates for your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta for Developers → WhatsApp product).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_NUMBER=
