# Copy this to ".env" in this same folder (NOT inside backend/) and fill in
# your values. docker-compose.yml reads this automatically to configure
# both containers — you don't need to touch docker-compose.yml itself.
#
# NEVER commit the real .env — it's already in .gitignore.

# --- Gemini (OCR + auto-categorization) ---
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google renames/retires flash models every few months — check
# https://ai.google.dev/gemini-api/docs/models if this one stops working.
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (Auth + eventually Postgres) ---
# Both from your Supabase project: Project Settings → API
# SUPABASE_URL is the project URL (used server-side to verify Auth tokens
# via JWKS, and client-side by the browser).
SUPABASE_URL=
# The PUBLISHABLE (anon) key — safe to expose to the browser, protected by
# Row Level Security. Do NOT put the secret/service_role key here or
# anywhere in this project; nothing in this app needs it.
SUPABASE_PUBLISHABLE_KEY=

# --- Database ---
# Leave unset to use local SQLite (zero setup). To use Supabase Postgres
# instead: Supabase dashboard → Project Settings → Database → Connection
# string → URI → "Transaction pooler" mode. Put your DB password directly
# in this value — never paste it in chat with an AI assistant.
# DATABASE_URL=postgresql://postgres.xxxxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres

# --- Production only ---
# Once your frontend is deployed (e.g. to Vercel), set this so the backend's
# CORS allows it. Leave blank for local dev.
# PRODUCTION_FRONTEND_URL=https://your-app.vercel.app
