# Preview defaults preserve the fully stocked demo. Do not deploy publicly with these defaults.
APP_MODE=preview
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
SESSION_TTL_DAYS=14
MAX_SESSIONS_PER_ACCOUNT=10
WORKSPACE_SNAPSHOT_LIMIT=10000
LOG_LEVEL=info

# Required production settings (inject through your secret manager):
# APP_MODE=production
# APP_ORIGIN=https://shop.your-domain.example
# SECURITY_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# DATABASE_URL=YOUR_MANAGED_POSTGRES_CONNECTION_STRING
# DATABASE_SSL=true
# DATABASE_CA_CERT=OPTIONAL_PEM_CA_CERTIFICATE
# ALLOW_DEMO_WORKSPACES=false
# SEED_NEW_ACCOUNTS=false
# EMBEDDED_PREVIEW=false
# ALLOW_SIGNUP=true

# Trust forwarded headers ONLY behind a proxy that overwrites them.
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1

# Embedding is opt-in for production. Exact HTTPS origins only, comma separated.
# EMBEDDED_PREVIEW=true
# ALLOWED_FRAME_ORIGINS=https://your-parent-app.example

# Use a separate DDL-capable account in your deployment migration job.
# MIGRATION_DATABASE_URL=YOUR_MIGRATION_POSTGRES_CONNECTION_STRING
# NEXT_STANDALONE=true
