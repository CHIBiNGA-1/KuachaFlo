# Supabase project → Settings → API. Both are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the FastAPI backend is reachable from the browser.
# Local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# MoMo numbers shown on the upgrade screen (optional — sensible defaults exist).
NEXT_PUBLIC_AIRTEL_MOMO_NUMBER=
NEXT_PUBLIC_MTN_MOMO_NUMBER=
